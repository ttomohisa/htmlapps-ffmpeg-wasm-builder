PROFILE_DISPLAY_NAME="Video Contact Sheet"
PROFILE_USE_X264=0
PROFILE_USE_WORKERFS=1
PROFILE_BINARY_LICENSE="LGPL-2.1-or-later"
PROFILE_OUTPUT_DESCRIPTION="RGB PPM contact sheet + JSON sample metadata"
PROFILE_REQUIRED_CONFIG=(
  CONFIG_H264_DECODER
  CONFIG_HEVC_DECODER
  CONFIG_VP8_DECODER
  CONFIG_VP9_DECODER
  CONFIG_AV1_DECODER
  CONFIG_MPEG4_DECODER
  CONFIG_MJPEG_DECODER
  CONFIG_PRORES_DECODER
  CONFIG_MOV_DEMUXER
  CONFIG_MATROSKA_DEMUXER
  CONFIG_FILE_PROTOCOL
  CONFIG_SWSCALE
)
PROFILE_LINK_LIBS=(
  libavformat/libavformat.a
  libavcodec/libavcodec.a
  libswscale/libswscale.a
  libavutil/libavutil.a
)
PROFILE_CAPABILITIES_JSON='{"operation":"video-contact-sheet","sampleCounts":[12,24,48],"seekSampling":true,"decodeVideo":true,"encodeVideo":false,"imageEncoder":false,"output":"RGB PPM + JSON","browserCanvasExport":true,"rotation":true,"workerFsInput":true,"arbitraryFfmpegArgs":false}'
