PROFILE_DISPLAY_NAME="Video Reverse (experimental)"
PROFILE_USE_X264=1
PROFILE_USE_LIBVPX=0
PROFILE_USE_LIBOPUS=0
PROFILE_USE_LIBWEBP=0
PROFILE_USE_WORKERFS=1
PROFILE_BINARY_LICENSE="GPL-2.0-or-later"
PROFILE_OUTPUT_DESCRIPTION="bounded reversed H.264 MP4 chunk (video only, no audio)"
PROFILE_REQUIRED_CONFIG=(
  CONFIG_LIBX264
  CONFIG_LIBX264_ENCODER
  CONFIG_H264_DECODER
  CONFIG_HEVC_DECODER
  CONFIG_MOV_DEMUXER
  CONFIG_MATROSKA_DEMUXER
  CONFIG_MP4_MUXER
  CONFIG_FILE_PROTOCOL
  CONFIG_SCALE_FILTER
  CONFIG_FPS_FILTER
  CONFIG_REVERSE_FILTER
  CONFIG_TRIM_FILTER
  CONFIG_SETPTS_FILTER
  CONFIG_TRANSPOSE_FILTER
  CONFIG_HFLIP_FILTER
  CONFIG_VFLIP_FILTER
  CONFIG_FORMAT_FILTER
  CONFIG_SETSAR_FILTER
)
PROFILE_LINK_LIBS=(
  libavfilter/libavfilter.a
  libavformat/libavformat.a
  libavcodec/libavcodec.a
  libswresample/libswresample.a
  libswscale/libswscale.a
  libavutil/libavutil.a
)
PROFILE_FILTERS_JSON='["trim","setpts","transpose","hflip","vflip","scale","fps","reverse","format","setsar"]'
PROFILE_ENCODERS_JSON='["libx264"]'
PROFILE_DECODERS_JSON='["h264","hevc","vp8","vp9","av1","mpeg4","mjpeg"]'
PROFILE_MUXERS_JSON='["mp4"]'
PROFILE_DEMUXERS_JSON='["mov","matroska"]'
PROFILE_CAPABILITIES_JSON='{"operation":"video-reverse-chunk","experimental":true,"mode":"reverse","durationMinSeconds":0.1,"durationMaxSeconds":2,"frameBufferEstimateMaxMiB":96,"output":"H.264 MP4, no audio","input":"WORKERFS","streamCopy":false,"autorotate":true,"chunkStitching":"experimental-public-libav-remux","arbitraryFfmpegArgs":false,"requiresRealDeviceValidation":true}'
