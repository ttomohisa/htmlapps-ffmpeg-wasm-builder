PROFILE_DISPLAY_NAME="FFmpeg Filter Builder"
PROFILE_USE_X264=1
PROFILE_USE_ZLIB=1
PROFILE_USE_LIBVPX=0
PROFILE_USE_LIBOPUS=0
PROFILE_USE_LIBWEBP=0
PROFILE_USE_WORKERFS=1
PROFILE_BINARY_LICENSE="GPL-2.0-or-later"
PROFILE_OUTPUT_DESCRIPTION="visual filtergraph preview/render; initial H.264/AAC MP4 runtime"
PROFILE_THREADING_VARIANTS="single-thread,multi-thread"
PROFILE_PTHREAD_POOL_SIZE=8
PROFILE_DECODER_THREAD_COUNT=2
PROFILE_ENCODER_THREAD_COUNT=4
PROFILE_X264_LOOKAHEAD_THREAD_COUNT=1
PROFILE_REQUIRED_CONFIG=(
  CONFIG_ZLIB
  CONFIG_LIBX264
  CONFIG_LIBX264_ENCODER
  CONFIG_AAC_ENCODER
  CONFIG_H264_DECODER
  CONFIG_HEVC_DECODER
  CONFIG_VP8_DECODER
  CONFIG_VP9_DECODER
  CONFIG_AV1_DECODER
  CONFIG_MPEG4_DECODER
  CONFIG_MJPEG_DECODER
  CONFIG_PNG_DECODER
  CONFIG_AAC_DECODER
  CONFIG_MP3_DECODER
  CONFIG_OPUS_DECODER
  CONFIG_FLAC_DECODER
  CONFIG_MOV_DEMUXER
  CONFIG_MATROSKA_DEMUXER
  CONFIG_IMAGE2_DEMUXER
  CONFIG_OGG_DEMUXER
  CONFIG_MP3_DEMUXER
  CONFIG_WAV_DEMUXER
  CONFIG_FLAC_DEMUXER
  CONFIG_MP4_MUXER
  CONFIG_FILE_PROTOCOL
  CONFIG_SCALE_FILTER
  CONFIG_CROP_FILTER
  CONFIG_PAD_FILTER
  CONFIG_FPS_FILTER
  CONFIG_TRANSPOSE_FILTER
  CONFIG_HFLIP_FILTER
  CONFIG_VFLIP_FILTER
  CONFIG_SETDAR_FILTER
  CONFIG_SETSAR_FILTER
  CONFIG_SETPTS_FILTER
  CONFIG_EQ_FILTER
  CONFIG_HUE_FILTER
  CONFIG_BOXBLUR_FILTER
  CONFIG_GBLUR_FILTER
  CONFIG_UNSHARP_FILTER
  CONFIG_FADE_FILTER
  CONFIG_SPLIT_FILTER
  CONFIG_OVERLAY_FILTER
  CONFIG_FORMAT_FILTER
  CONFIG_COLORCHANNELMIXER_FILTER
  CONFIG_ATRIM_FILTER
  CONFIG_ASETPTS_FILTER
  CONFIG_VOLUME_FILTER
  CONFIG_AFADE_FILTER
  CONFIG_ATEMPO_FILTER
  CONFIG_HIGHPASS_FILTER
  CONFIG_LOWPASS_FILTER
  CONFIG_LOUDNORM_FILTER
  CONFIG_AMIX_FILTER
  CONFIG_ASPLIT_FILTER
  CONFIG_ARESAMPLE_FILTER
)
PROFILE_LINK_LIBS=(
  libavfilter/libavfilter.a
  libavformat/libavformat.a
  libavcodec/libavcodec.a
  libswresample/libswresample.a
  libswscale/libswscale.a
  libavutil/libavutil.a
)
PROFILE_FILTERS_JSON='["scale","crop","pad","fps","transpose","hflip","vflip","setdar","setsar","setpts","eq","hue","boxblur","gblur","unsharp","fade","split","overlay","format","colorchannelmixer","atrim","asetpts","volume","afade","atempo","highpass","lowpass","loudnorm","amix","asplit","aresample"]'
PROFILE_ENCODERS_JSON='["libx264","aac"]'
PROFILE_DECODERS_JSON='["h264","hevc","vp8","vp9","av1","mpeg4","mjpeg","png","aac","mp3","opus","flac"]'
PROFILE_MUXERS_JSON='["mp4"]'
PROFILE_DEMUXERS_JSON='["mov","matroska","image2","ogg","mp3","wav","flac"]'
PROFILE_CAPABILITIES_JSON='{"operation":"filter-builder","graphCompiler":true,"customVideoFilter":true,"customAudioFilter":true,"complexGraph":false,"multipleInputs":false,"outputs":["H.264 + AAC MP4"],"workerFsInput":true,"threadingVariants":["single-thread","multi-thread"],"arbitraryFfmpegArgs":false,"drawText":false}'
