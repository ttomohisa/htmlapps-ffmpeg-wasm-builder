--enable-decoder=hevc
--enable-decoder=vp8
--enable-decoder=vp9
--enable-decoder=av1
--enable-decoder=mpeg4
--enable-decoder=mjpeg
--enable-decoder=png
--enable-decoder=aac
--enable-decoder=mp3
--enable-decoder=opus
--enable-decoder=flac
--enable-gpl
--enable-libx264
--enable-encoder=libx264
--enable-encoder=aac
--enable-muxer=mp4
