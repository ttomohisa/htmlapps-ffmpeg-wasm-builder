PROFILE_DISPLAY_NAME="Media Inspector"
PROFILE_USE_X264=0
PROFILE_USE_LIBWEBP=0
PROFILE_USE_WORKERFS=1
PROFILE_BINARY_LICENSE="LGPL-2.1-or-later"
PROFILE_OUTPUT_DESCRIPTION="structured JSON media/container/stream inspection"
PROFILE_REQUIRED_CONFIG=(
  CONFIG_MOV_DEMUXER
  CONFIG_MATROSKA_DEMUXER
  CONFIG_OGG_DEMUXER
  CONFIG_MP3_DEMUXER
  CONFIG_WAV_DEMUXER
  CONFIG_FLAC_DEMUXER
  CONFIG_H264_PARSER
  CONFIG_HEVC_PARSER
  CONFIG_AV1_PARSER
  CONFIG_FILE_PROTOCOL
)
PROFILE_LINK_LIBS=(
  libavformat/libavformat.a
  libavcodec/libavcodec.a
  libavutil/libavutil.a
)
PROFILE_CAPABILITIES_JSON='{"operation":"inspect-media","structuredJson":true,"format":true,"duration":true,"fileSize":true,"bitrate":true,"video":true,"audio":true,"subtitles":true,"metadata":true,"chapters":true,"rotation":true,"hdr":true,"codecTag":true,"workerFsInput":true,"decode":false,"encode":false,"arbitraryFfmpegArgs":false}'
