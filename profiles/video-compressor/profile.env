PROFILE_DISPLAY_NAME="Video Compressor"
PROFILE_USE_X264=1
PROFILE_USE_LIBWEBP=0
PROFILE_USE_WORKERFS=0
PROFILE_BINARY_LICENSE="GPL-2.0-or-later"
PROFILE_OUTPUT_DESCRIPTION="H.264 + AAC MP4"
PROFILE_REQUIRED_CONFIG=(
  CONFIG_LIBX264
  CONFIG_LIBX264_ENCODER
  CONFIG_AAC_ENCODER
  CONFIG_H264_DECODER
  CONFIG_HEVC_DECODER
  CONFIG_MOV_DEMUXER
  CONFIG_MP4_MUXER
  CONFIG_FILE_PROTOCOL
  CONFIG_SCALE_FILTER
  CONFIG_ARESAMPLE_FILTER
)
PROFILE_LINK_LIBS=(
  libavfilter/libavfilter.a
  libavformat/libavformat.a
  libavcodec/libavcodec.a
  libswresample/libswresample.a
  libswscale/libswscale.a
  libavutil/libavutil.a
)
PROFILE_CAPABILITIES_JSON='{"operation":"transcode","streamCopy":false,"output":"H.264 + AAC MP4","resize":true,"fps":true,"crf":true,"videoBitrate":true,"audioBitrate":true,"dropAudio":true,"keyframeAlignedCut":false,"arbitraryFfmpegArgs":false}'
