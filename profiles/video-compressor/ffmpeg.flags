# Public-library browser runner.
# No fftools/ffmpeg program is linked. FFmpeg/x264 threading is disabled so the
# generated WASM does not require SharedArrayBuffer.
--enable-gpl
--enable-small
--disable-everything
--enable-libx264
--enable-encoder=libx264
--enable-libvpx
# FFmpeg configure uses the component name libvpx_vp9; the runtime codec name is libvpx-vp9.
--enable-encoder=libvpx_vp9
--enable-libopus
--enable-encoder=libopus
--enable-encoder=aac
--enable-decoder=h264
--enable-decoder=hevc
--enable-decoder=vp8
--enable-decoder=vp9
--enable-decoder=av1
--enable-decoder=mpeg4
--enable-decoder=mjpeg
--enable-decoder=prores
--enable-decoder=aac
--enable-decoder=mp3
--enable-decoder=opus
--enable-decoder=vorbis
--enable-decoder=flac
--enable-decoder=alac
--enable-decoder=pcm_s16le
--enable-decoder=pcm_s24le
--enable-decoder=pcm_f32le
--enable-demuxer=mov
--enable-demuxer=matroska
--enable-demuxer=avi
--enable-demuxer=mpegts
--enable-demuxer=ogg
--enable-demuxer=mp3
--enable-demuxer=wav
--enable-demuxer=flac
--enable-muxer=mp4
--enable-muxer=webm
--enable-parser=h264
--enable-parser=hevc
--enable-parser=aac
--enable-parser=av1
--enable-parser=vp9
--enable-protocol=file
--enable-filter=scale
--enable-filter=transpose
--enable-filter=hflip
--enable-filter=vflip
--enable-filter=format
--enable-filter=fps
--enable-filter=setsar
--enable-filter=anull
--enable-filter=null
--enable-filter=aresample
