PROFILE_DISPLAY_NAME="Lossless Video Cutter"
PROFILE_USE_X264=0
PROFILE_USE_WORKERFS=1
PROFILE_BINARY_LICENSE="LGPL-2.1-or-later"
PROFILE_OUTPUT_DESCRIPTION="stream-copy cut; container chosen by output extension"
PROFILE_REQUIRED_CONFIG=(
  CONFIG_MOV_DEMUXER
  CONFIG_MATROSKA_DEMUXER
  CONFIG_MP4_MUXER
  CONFIG_MOV_MUXER
  CONFIG_MATROSKA_MUXER
  CONFIG_WEBM_MUXER
  CONFIG_FILE_PROTOCOL
)
PROFILE_LINK_LIBS=(
  libavformat/libavformat.a
  libavcodec/libavcodec.a
  libavutil/libavutil.a
)
PROFILE_CAPABILITIES_JSON='{"operation":"lossless-cut","streamCopy":true,"output":"same-codec remux; MP4/MOV/MKV/WebM containers","resize":false,"fps":false,"crf":false,"videoBitrate":false,"audioBitrate":false,"dropAudio":true,"keyframeAlignedCut":true,"workerFsInput":true,"arbitraryFfmpegArgs":false}'
