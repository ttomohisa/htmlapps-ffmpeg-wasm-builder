PROFILE_DISPLAY_NAME="Video Speed Changer"
PROFILE_USE_X264=1
PROFILE_USE_LIBVPX=0
PROFILE_USE_LIBOPUS=0
PROFILE_USE_LIBWEBP=0
PROFILE_USE_WORKERFS=1
PROFILE_BINARY_LICENSE="GPL-2.0-or-later"
PROFILE_OUTPUT_DESCRIPTION="speed-adjusted H.264/AAC MP4 or H.264-only MP4"
PROFILE_REQUIRED_CONFIG=(
  CONFIG_LIBX264
  CONFIG_LIBX264_ENCODER
  CONFIG_AAC_ENCODER
  CONFIG_H264_DECODER
  CONFIG_HEVC_DECODER
  CONFIG_MOV_DEMUXER
  CONFIG_MATROSKA_DEMUXER
  CONFIG_MP4_MUXER
  CONFIG_FILE_PROTOCOL
  CONFIG_SCALE_FILTER
  CONFIG_FORMAT_FILTER
  CONFIG_SETSAR_FILTER
  CONFIG_TRANSPOSE_FILTER
  CONFIG_HFLIP_FILTER
  CONFIG_VFLIP_FILTER
  CONFIG_SETPTS_FILTER
  CONFIG_ATEMPO_FILTER
  CONFIG_ASETRATE_FILTER
  CONFIG_ARESAMPLE_FILTER
)
PROFILE_LINK_LIBS=(
  libavfilter/libavfilter.a
  libavformat/libavformat.a
  libavcodec/libavcodec.a
  libswresample/libswresample.a
  libswscale/libswscale.a
  libavutil/libavutil.a
)
PROFILE_CAPABILITIES_JSON='{"operation":"speed-change","streamCopy":false,"output":"H.264 MP4 (optional AAC)","rateMin":0.25,"rateMax":4.0,"preservePitch":true,"shiftPitch":true,"dropAudio":true,"autoRotate":true,"workerFsInput":true,"arbitraryFfmpegArgs":false}'
