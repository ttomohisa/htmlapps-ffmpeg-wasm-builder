PROFILE_DISPLAY_NAME="Video to Animated GIF"
PROFILE_USE_X264=0
PROFILE_USE_LIBWEBP=0
PROFILE_USE_WORKERFS=1
PROFILE_BINARY_LICENSE="LGPL-2.1-or-later"
PROFILE_OUTPUT_DESCRIPTION="trimmed/scaled animated GIF with palettegen + paletteuse"
PROFILE_REQUIRED_CONFIG=(
  CONFIG_H264_DECODER
  CONFIG_HEVC_DECODER
  CONFIG_VP8_DECODER
  CONFIG_VP9_DECODER
  CONFIG_AV1_DECODER
  CONFIG_MOV_DEMUXER
  CONFIG_MATROSKA_DEMUXER
  CONFIG_GIF_ENCODER
  CONFIG_GIF_MUXER
  CONFIG_FILE_PROTOCOL
  CONFIG_FPS_FILTER
  CONFIG_SCALE_FILTER
  CONFIG_CROP_FILTER
  CONFIG_SETSAR_FILTER
  CONFIG_SETPTS_FILTER
  CONFIG_PALETTEGEN_FILTER
  CONFIG_PALETTEUSE_FILTER
  CONFIG_TRANSPOSE_FILTER
  CONFIG_SWSCALE
)
PROFILE_LINK_LIBS=(
  libavfilter/libavfilter.a
  libavformat/libavformat.a
  libavcodec/libavcodec.a
  libswscale/libswscale.a
  libavutil/libavutil.a
)
PROFILE_CAPABILITIES_JSON='{"operation":"video-to-animated-gif","trim":true,"resize":true,"crop":true,"fps":true,"palettegen":true,"paletteuse":true,"colors":true,"dither":true,"autorotate":true,"loop":true,"audio":false,"workerFsInput":true,"arbitraryFfmpegArgs":false}'
