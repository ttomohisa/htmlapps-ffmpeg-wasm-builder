# Video -> Animated GIF. Decode only common video formats; no audio stack and no CLI.
--enable-small
--disable-everything
--enable-swscale
--enable-decoder=h264
--enable-decoder=hevc
--enable-decoder=vp8
--enable-decoder=vp9
--enable-decoder=av1
--enable-decoder=mpeg4
--enable-decoder=mpeg1video
--enable-decoder=mpeg2video
--enable-decoder=mjpeg
--enable-decoder=prores
--enable-decoder=theora
--enable-demuxer=mov
--enable-demuxer=matroska
--enable-demuxer=avi
--enable-demuxer=mpegts
--enable-demuxer=mpeg
--enable-demuxer=flv
--enable-demuxer=asf
--enable-demuxer=ogg
--enable-parser=h264
--enable-parser=hevc
--enable-parser=av1
--enable-parser=vp8
--enable-parser=vp9
--enable-parser=mpeg4video
--enable-parser=mpegvideo
--enable-encoder=gif
--enable-muxer=gif
--enable-protocol=file
--enable-filter=scale
--enable-filter=crop
--enable-filter=format
--enable-filter=fps
--enable-filter=setsar
--enable-filter=setpts
--enable-filter=palettegen
--enable-filter=paletteuse
--enable-filter=transpose
--enable-filter=hflip
--enable-filter=vflip
