PROFILE_DISPLAY_NAME="Video Audio Extractor"
PROFILE_USE_X264=0
PROFILE_USE_LIBWEBP=0
PROFILE_USE_WORKERFS=1
PROFILE_BINARY_LICENSE="LGPL-2.1-or-later"
PROFILE_OUTPUT_DESCRIPTION="audio stream inventory JSON and validated single-track stream copy"
PROFILE_REQUIRED_CONFIG=(
  CONFIG_MOV_DEMUXER
  CONFIG_MATROSKA_DEMUXER
  CONFIG_MPEGTS_DEMUXER
  CONFIG_AVI_DEMUXER
  CONFIG_FLV_DEMUXER
  CONFIG_ASF_DEMUXER
  CONFIG_OGG_DEMUXER
  CONFIG_IPOD_MUXER
  CONFIG_OGG_MUXER
  CONFIG_MP3_MUXER
  CONFIG_FLAC_MUXER
  CONFIG_AAC_ADTSTOASC_BSF
  CONFIG_FILE_PROTOCOL
)
PROFILE_LINK_LIBS=(
  libavformat/libavformat.a
  libavcodec/libavcodec.a
  libswresample/libswresample.a
  libavutil/libavutil.a
)
PROFILE_CAPABILITIES_JSON='{"operation":"video-audio-extractor","inspectAudioStreams":true,"singleTrack":true,"streamCopy":true,"copyFormats":["m4a","opus","mp3","ogg","flac"],"transcode":true,"transcodeFormats":["m4a","wav"],"aacBitratesKbps":[128,192,256],"pcmBits":16,"workerFsInput":true,"arbitraryFfmpegArgs":false}'
