# Phase 1 Video Audio Extractor: inspect media headers and copy one selected
# audio stream without decoding or encoding. Keep the core LGPL and small.
--enable-small
--disable-everything
--disable-avfilter
--disable-swscale
--disable-swresample
--enable-demuxer=mov
--enable-demuxer=matroska
--enable-demuxer=avi
--enable-demuxer=mpegts
--enable-demuxer=mpeg
--enable-demuxer=flv
--enable-demuxer=asf
--enable-demuxer=ogg
--enable-demuxer=mp3
--enable-demuxer=wav
--enable-demuxer=flac
--enable-demuxer=aac
--enable-demuxer=ac3
--enable-demuxer=eac3
--enable-muxer=ipod
--enable-muxer=mp3
--enable-muxer=ogg
--enable-muxer=flac
--enable-muxer=wav
--enable-muxer=ac3
--enable-muxer=eac3
--enable-parser=h264
--enable-parser=hevc
--enable-parser=av1
--enable-parser=vp8
--enable-parser=vp9
--enable-parser=aac
--enable-parser=aac_latm
--enable-parser=ac3
--enable-parser=mpegaudio
--enable-parser=opus
--enable-bsf=aac_adtstoasc
--enable-protocol=file
