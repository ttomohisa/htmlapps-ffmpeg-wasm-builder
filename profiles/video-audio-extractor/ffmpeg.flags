# Phase 3 Video Audio Extractor profile.
# Inspect/copy audio packets or transcode one selected audio track.
# No video decode/encode, filters, swscale, x264, or external audio codec library is linked.
--enable-small
--disable-everything
--disable-avfilter
--disable-swscale
--enable-demuxer=mov
--enable-demuxer=matroska
--enable-demuxer=avi
--enable-demuxer=mpegts
--enable-demuxer=flv
--enable-demuxer=asf
--enable-demuxer=ogg
--enable-demuxer=wav
--enable-parser=h264
--enable-parser=aac
--enable-parser=aac_latm
--enable-parser=opus
--enable-decoder=aac
--enable-decoder=alac
--enable-decoder=mp3
--enable-decoder=opus
--enable-decoder=vorbis
--enable-decoder=flac
--enable-encoder=aac
--enable-encoder=pcm_s16le
--enable-muxer=ipod
--enable-muxer=ogg
--enable-muxer=mp3
--enable-muxer=flac
--enable-muxer=wav
--enable-bsf=aac_adtstoasc
--enable-protocol=file
