PROFILE_DISPLAY_NAME="Video to Animated WebP"
PROFILE_USE_X264=0
PROFILE_USE_LIBWEBP=1
PROFILE_USE_WORKERFS=1
PROFILE_BINARY_LICENSE="LGPL-2.1-or-later"
PROFILE_OUTPUT_DESCRIPTION="trimmed/scaled animated WebP via libwebp_anim"
PROFILE_REQUIRED_CONFIG=(
  CONFIG_LIBWEBP
  CONFIG_LIBWEBP_ANIM_ENCODER
  CONFIG_H264_DECODER
  CONFIG_HEVC_DECODER
  CONFIG_VP8_DECODER
  CONFIG_VP9_DECODER
  CONFIG_AV1_DECODER
  CONFIG_MOV_DEMUXER
  CONFIG_MATROSKA_DEMUXER
  CONFIG_WEBP_MUXER
  CONFIG_FILE_PROTOCOL
  CONFIG_FPS_FILTER
  CONFIG_SCALE_FILTER
  CONFIG_CROP_FILTER
  CONFIG_SETSAR_FILTER
  CONFIG_SETPTS_FILTER
  CONFIG_TRANSPOSE_FILTER
  CONFIG_SWSCALE
)
PROFILE_LINK_LIBS=(
  libavfilter/libavfilter.a
  libavformat/libavformat.a
  libavcodec/libavcodec.a
  libswscale/libswscale.a
  libavutil/libavutil.a
)
PROFILE_CAPABILITIES_JSON='{"operation":"video-to-animated-webp","trim":true,"resize":true,"crop":true,"fps":true,"quality":true,"lossless":true,"compressionLevel":true,"autorotate":true,"loop":true,"audio":false,"libwebp":true,"workerFsInput":true,"arbitraryFfmpegArgs":false}'
