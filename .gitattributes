* text=auto

# Build/container files must stay LF even when the repository is cloned on Windows.
*.sh text eol=lf
*.ps1 text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.env text eol=lf
*.flags text eol=lf
*.c text eol=lf
*.js text eol=lf
*.html text eol=lf
Dockerfile text eol=lf

# Windows launchers are intended for cmd.exe.
*.bat text eol=crlf

# Test media is binary.
*.mp4 binary
