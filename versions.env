# Release/build pins. Update one dependency at a time, then run build.bat.
BUILDER_VERSION=1.6.0

# Docker image tag used for the compiler toolchain. The Emscripten source tag
# and commit are pinned separately so public releases can ship the exact source
# corresponding to generated runtime code.
EMSDK_VERSION=6.0.6
EMSCRIPTEN_REPOSITORY=https://github.com/emscripten-core/emscripten.git
EMSCRIPTEN_REF=6.0.6
EMSCRIPTEN_COMMIT=ce75e06884093bcefb86a6b8fd56a5d62a4cc245

# FFmpeg is pinned by tag + resolved commit for reproducible builds.
FFMPEG_REPOSITORY=https://github.com/FFmpeg/FFmpeg.git
FFMPEG_REF=n9.0.1
FFMPEG_COMMIT=bf1b838f2ab88b4f8fd83443325c782ea0e0f7fa

# x264 has no regular numbered release cadence, so pin an exact commit.
X264_REPOSITORY=https://code.videolan.org/videolan/x264.git
X264_FALLBACK_REPOSITORY=https://github.com/mirror/x264.git
X264_REF=stable
X264_COMMIT=31e19f92f00c7003fa115047ce50978bc98c3a0d

# libwebp is needed only by the animated-WebP profile. Pin the exact commit
# behind the v1.6.0 tag so release builds remain reproducible.
LIBWEBP_REPOSITORY=https://chromium.googlesource.com/webm/libwebp
LIBWEBP_FALLBACK_REPOSITORY=https://github.com/webmproject/libwebp.git
LIBWEBP_REF=v1.6.0
LIBWEBP_COMMIT=4fa21912338357f89e4fd51cf2368325b59e9bd9


# libvpx is used only by the video-compressor profile for VP9/WebM output.
# Pin the exact commit behind v1.16.0 for reproducible builds.
LIBVPX_REPOSITORY=https://chromium.googlesource.com/webm/libvpx
LIBVPX_FALLBACK_REPOSITORY=https://github.com/webmproject/libvpx.git
LIBVPX_REF=v1.16.0
LIBVPX_COMMIT=1024874c5919305883187e2953de8fcb4c3d7fa6

# Opus is used only by the video-compressor profile for WebM audio.
# v1.5.2 is a stable three-clause-BSD release with a royalty-free patent grant.
LIBOPUS_REPOSITORY=https://github.com/xiph/opus.git
LIBOPUS_FALLBACK_REPOSITORY=https://gitlab.xiph.org/xiph/opus.git
LIBOPUS_REF=v1.5.2
LIBOPUS_COMMIT=ddbe48383984d56acd9e1ab6a090c54ca6b735a6
